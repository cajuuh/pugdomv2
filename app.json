{
  "expo": {
    "name": "pugdon",
    "slug": "pugdom",
    "scheme": "pugdom",
    "version": "1.3.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "bundleIdentifier": "com.cajuuh.pugdom",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF4EF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cajuuh.pugdom",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "b034b44b-e429-4a96-b049-74c54fe27444"
      }
    },
    "owner": "cajuuh1337",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b034b44b-e429-4a96-b049-74c54fe27444"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FBF4EF",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#16120E"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "pugdon opens your photos so you can attach them to posts.",
          "cameraPermission": "pugdon uses the camera so you can take a photo or record a video for a post.",
          "microphonePermission": "pugdon uses the microphone to record sound with videos for your posts."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "pugdon opens your photos so you can attach them to posts.",
          "savePhotosPermission": "pugdon saves photos and videos from posts to your library when you tap Save.",
          "granularPermissions": []
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": ["text/plain", "image/*", "video/*"],
            "multipleShareMimeTypes": ["image/*"]
          },
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1,
              "supportsImageWithMaxCount": 4,
              "supportsMovieWithMaxCount": 1
            }
          }
        }
      ]
    ],
    "locales": {
      "pt-BR": "./locales/pt-BR.json"
    }
  }
}
