{
  "expo": {
    "name": "pugdon",
    "slug": "pugdom",
    "scheme": "pugdom",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "bundleIdentifier": "com.cajuuh.pugdom",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF4EF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cajuuh.pugdom"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "b034b44b-e429-4a96-b049-74c54fe27444"
      }
    },
    "owner": "cajuuh1337",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b034b44b-e429-4a96-b049-74c54fe27444"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FBF4EF",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#16120E"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "pugdon opens your photos so you can attach them to posts.",
          "cameraPermission": "pugdon uses the camera so you can take a photo for a post.",
          "microphonePermission": false
        }
      ]
    ],
    "locales": {
      "pt-BR": "./locales/pt-BR.json"
    }
  }
}
