{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "testflight": {
      "extends": "preview",
      "distribution": "store",
      "ios": {
        "autoIncrement": true
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6818288991",
        "appleTeamId": "G6H6CPS7BU"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6818288991",
        "appleTeamId": "G6H6CPS7BU"
      }
    }
  }
}
